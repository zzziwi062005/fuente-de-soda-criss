# ============================================================
#  Fuente de Soda Criss — variables de entorno
#  1. Copia este archivo como .env.local  (cp .env.example .env.local)
#  2. Completa los valores desde Supabase → Project Settings → API
#  3. Reinicia `npm run dev`
#  .env.local está en .gitignore: NUNCA lo subas a GitHub.
# ============================================================

# URL del proyecto, ej. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave pública: "anon" (legacy) o "publishable" (sb_publishable_...).
# NUNCA uses aquí la service_role / secret key.
VITE_SUPABASE_ANON_KEY=
